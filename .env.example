# Database - MySQL
DB_URL=jdbc:mysql://localhost:3306/greenshield_db?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=root

# Cloudinary - get credentials from https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin seed - required for first run (creates admin@gmail.com)
ADMIN_PASSWORD=len_canvas@123

# Green AI (Gemini image generation)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Số ảnh tối đa hệ thống cho phép gen trong 1 ngày (toàn cục, mặc định 20)
DAILY_AI_IMAGE_LIMIT=20

# Google Cloud Text-to-Speech (REST API key)
# Get key: https://console.cloud.google.com/apis/credentials
GOOGLE_TTS_API_KEY=your_tts_api_key
